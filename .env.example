# Local development only. Copy to .env; never commit .env.
POSTGRES_USER=mind_count
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=mind_count
POSTGRES_PORT=5432
API_PORT=8080
WEB_PORT=3000
# Host-side Go commands use this URL; Compose builds its internal URL separately.
DATABASE_URL=postgres://mind_count:local-development-only@localhost:5432/mind_count?sslmode=disable
HTTP_ADDR=:8080
LOG_LEVEL=info
DB_MAX_CONNS=10
DB_MAX_CONN_LIFETIME=30m
DB_HEALTH_CHECK_PERIOD=30s
DB_CONNECT_TIMEOUT=5s
DB_OPERATION_TIMEOUT=5s
HTTP_READ_TIMEOUT=10s
HTTP_READ_HEADER_TIMEOUT=5s
HTTP_WRITE_TIMEOUT=15s
HTTP_IDLE_TIMEOUT=60s
SHUTDOWN_TIMEOUT=10s
READINESS_TIMEOUT=2s
MIGRATION_TIMEOUT=2m
CORS_ALLOWED_ORIGINS=http://localhost:3000
RATE_LIMIT_RPS=20
RATE_LIMIT_BURST=40
RATE_LIMIT_MAX_CLIENTS=10000
# Private server-only setting for a host-side Nuxt process.
NUXT_API_BASE_URL=http://localhost:8080
NUXT_API_TIMEOUT_MS=5000
# Browser testing against an already running Compose stack.
PLAYWRIGHT_BASE_URL=http://127.0.0.1:3000
# JWT and cookie settings are introduced with their implementation in Phase 1.
